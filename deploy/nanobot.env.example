# Copy to /opt/marketing-agent/secrets/nanobot.env and fill real values.
# This file is loaded by systemd for the Nanobot gateway process.

APP_BASE_URL=https://auth.monozlab.com
OAUTH_BROKER_INTERNAL_URL=http://127.0.0.1:8787
OAUTH_BROKER_INTERNAL_API_KEY=
CLIENT_TIMEZONE=Asia/Kuala_Lumpur

# Optional provider overrides. Secrets can also live in nanobot-config.json.
# NANOBOT_PROVIDERS__OPENROUTER__API_KEY=

# Keep Python CLI output predictable under systemd.
PYTHONUNBUFFERED=1

# Expose the local Agent VPN Broker tools when the broker service is installed.
AGENT_VPN_BROKER_ENABLED=false

# Enable only after crawl4ai-worker.service is installed and its health check passes.
# The foreground crawler role receives rendered HTML; Crawl4AI itself has no LLM credentials.
CRAWL4AI_WORKER_ENABLED=false
CRAWL4AI_WORKER_SOCKET=/run/crawl4ai-worker/worker.sock
