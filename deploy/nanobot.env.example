# Copy to /opt/marketing-agent/secrets/nanobot.env and fill real values.
# This file is loaded by systemd for the Nanobot gateway process.

APP_BASE_URL=https://auth.slopfactory.cc
OAUTH_BROKER_INTERNAL_URL=http://127.0.0.1:8787
OAUTH_BROKER_INTERNAL_API_KEY=
CLIENT_TIMEZONE=Asia/Kuala_Lumpur

# Optional provider overrides. Secrets can also live in nanobot-config.json.
# NANOBOT_PROVIDERS__OPENROUTER__API_KEY=

# Keep Python CLI output predictable under systemd.
PYTHONUNBUFFERED=1
