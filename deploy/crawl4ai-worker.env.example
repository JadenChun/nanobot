# Copy to /etc/crawl4ai-worker/crawl4ai-worker.env.
# This process intentionally has no Nanobot or LLM provider credentials.

CRAWL4AI_WORKER_SOCKET=/run/crawl4ai-worker/worker.sock
CRAWL4AI_SESSION_TTL_SECONDS=300

# Exact domains and their subdomains are allowed. Start narrowly and extend only
# after a platform-specific test. TikTok is intentionally deferred for now.
CRAWL4AI_ALLOWED_HOSTS=instagram.com,cdninstagram.com,threads.net,facebook.com,fbcdn.net,youtube.com,youtu.be,ytimg.com,googlevideo.com,gstatic.com,googleapis.com,egopetfood.com

PYTHONUNBUFFERED=1
PLAYWRIGHT_BROWSERS_PATH=/var/lib/crawl4ai-worker/ms-playwright
